{
  "name": "Roche Data Platform",
  "dataColors": ["#0B41CD", "#E8702A", "#12A38A", "#8C5CC7", "#7FA0FF", "#F2B705", "#B7C0CE", "#D6334B"],
  "background": "#FFFFFF",
  "foreground": "#0A1F44",
  "tableAccent": "#0B41CD",
  "good": "#1E8E5A",
  "neutral": "#F2B705",
  "bad": "#D6334B",
  "maximum": "#0B41CD",
  "center": "#7FA0FF",
  "minimum": "#E8EEFC",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#0A1F44" },
    "title": { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#0A1F44" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0A1F44" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#5B6576" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": false }],
        "title": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#5B6576" } }, "fontSize": 10, "showAxisTitle": false, "gridlineShow": false }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#5B6576" } }, "fontSize": 10, "showAxisTitle": false, "gridlineColor": { "solid": { "color": "#E2E7EF" } }, "gridlineStyle": "dotted" }],
        "legend": [{ "labelColor": { "solid": { "color": "#5B6576" } }, "fontSize": 10, "position": "Top" }],
        "labels": [{ "color": { "solid": { "color": "#0A1F44" } }, "fontSize": 10 }]
      }
    },
    "page": {
      "*": {
        "outspace": [{ "color": { "solid": { "color": "#F4F6FA" } } }],
        "background": [{ "transparency": 0 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": false }],
        "items": [{ "fontColor": { "solid": { "color": "#0A1F44" } }, "fontSize": 11 }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#5B6576" } }, "backColor": { "solid": { "color": "#FFFFFF" } }, "fontSize": 10 }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#0A1F44" } }, "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#F7F9FC" } }, "fontSize": 10 }],
        "grid": [{ "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#E2E7EF" } }, "gridVertical": false }]
      }
    }
  }
}
